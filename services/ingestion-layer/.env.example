# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nationpulse

# --- sansad.in ---
SANSAD_BASE_URL=https://sansad.in
REQUEST_TIMEOUT_SECONDS=60
USER_AGENT=NationPulseBot/1.0 (+contact@yourdomain.example)

# --- Fetch size per house ---
RS_FETCH_SIZE=3000
LS_FETCH_SIZE=6000

# --- Downstream pipelines ---
TRIGGER_DOWNSTREAM=true
PDF_PIPELINE_DIR=../pdf-pipeline
AI_PIPELINE_DIR=../ai-pipeline
AI_PROVIDER=gemini

# --- Optional document URL validation ---
VALIDATE_DOCUMENT_URLS=true
URL_CHECK_TIMEOUT_SECONDS=8
