# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nationpulse

# --- Gemini is the only supported summarization provider ---
AI_PROVIDER=gemini

# --- Gemini model failover order ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_2=gemini-3.1-pro-preview
GEMINI_MODEL_3=gemini-3-flash-preview
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Generation behavior ---
MAX_INPUT_CHARS=45000
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_SECONDS=90
MAX_RETRIES=3
RETRY_DELAY_SECONDS=3

# --- Prompt/schema versioning ---
PROMPT_VERSION=v1
