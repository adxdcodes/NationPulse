# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nationpulse

# --- Storage: local or s3 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage

# --- S3 storage (used only when STORAGE_BACKEND=s3) ---
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Download behavior ---
REQUEST_TIMEOUT_SECONDS=30
REQUEST_DELAY_SECONDS=1.5
MAX_RETRIES=3
USER_AGENT=NationPulseBot/1.0 (+contact@yourdomain.example)

# --- Concurrency ---
WORKER_THREADS=4

# --- OCR fallback ---
OCR_ENABLED=true
OCR_MAX_PAGES=25
MIN_TEXT_LAYER_CHARS=40
