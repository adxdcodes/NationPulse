# NationPulse unified environment configuration
# Copy this file to the repository root as .env and fill in your own values.
# Keep .env private; never commit credentials. Environment variables set by the OS take precedence.

# ========================= Shared database =========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nationpulse

# ========================= Supabase (QA module) ====================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_key_here

# ========================= AI / Gemini =============================
# AI summarization rotates these keys per Gemini API request: 1 -> 2 -> 3 -> 1.
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
# Optional single-key fallback for other services that still use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_2=gemini-3.1-pro-preview
GEMINI_MODEL_3=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_PROVIDER=gemini
MAX_INPUT_CHARS=45000
MAX_OUTPUT_TOKENS=2000
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
AI_RETRY_DELAY_SECONDS=3
PROMPT_VERSION=v1

# ========================= API / authentication ====================
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_HOURS=168
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
PDF_PIPELINE_DIR=services/pdf-pipeline
AI_PIPELINE_DIR=services/ai-pipeline
PUBLIC_API_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ========================= Ingestion ===============================
SANSAD_BASE_URL=https://sansad.in
INGESTION_REQUEST_TIMEOUT_SECONDS=60
INGESTION_USER_AGENT=NationPulseBot/1.0 (+contact@yourdomain.example)
RS_FETCH_SIZE=3000
LS_FETCH_SIZE=6000
TRIGGER_DOWNSTREAM=true
VALIDATE_DOCUMENT_URLS=true
URL_CHECK_TIMEOUT_SECONDS=8

# ========================= PDF pipeline ============================
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=services/pdf-pipeline/storage
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PDF_REQUEST_TIMEOUT_SECONDS=30
PDF_REQUEST_DELAY_SECONDS=1.5
PDF_MAX_RETRIES=3
PDF_USER_AGENT=NationPulseBot/1.0 (+contact@yourdomain.example)
WORKER_THREADS=4
OCR_ENABLED=true
OCR_MAX_PAGES=0
MIN_TEXT_LAYER_CHARS=40
OCR_DPI=200
OCR_LANGUAGE=eng
# Windows only if Tesseract is not on PATH
TESSERACT_CMD=

# ========================= Frontend (Vite) =========================
VITE_API_URL=http://localhost:8000
VITE_QA_API_URL=http://localhost:8001
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
