# --- Database (same DB as ingestion/pdf-pipeline/ai-pipeline) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nationpulse

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_HOURS=168

# --- CORS: the frontend origin(s) allowed to call this API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Pagination defaults ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Sibling service directories, for spawning admin-triggered processing jobs ---
PDF_PIPELINE_DIR=../services/pdf-pipeline
AI_PIPELINE_DIR=../services/ai-pipeline
AI_PROVIDER=gemini

# --- This API's own externally-reachable URL, for building links back to
# locally-stored files (extracted text) that the frontend opens directly ---
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Server ---
HOST=0.0.0.0
PORT=8000
